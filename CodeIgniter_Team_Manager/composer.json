{
  "name": "sgsamples/codeigniter-team-manager",
  "description": "Team Manager with CodeIgniter 4.7.0 framework.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "codeigniter4/framework": "4.7.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "kint-php/kint": "^6.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "scripts": {
    "post-update-cmd": [
      "CodeIgniter\\ComposerScripts::postUpdate"
    ],
    "post-install-cmd": [
      "CodeIgniter\\ComposerScripts::postUpdate"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
